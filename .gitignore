.env*
social-drafts/
pw-shots/

# Promo-Maschine (generierte Post-Kits)
promo-output/

# AGB-Export (one-off-Artefakt)
Steakakademie-AGB.pd
# Build-Artefakte (postbuild next-sitemap überschreibt sie ohnehin)
public/sitemap.xml
public/sitemap-0.xml

# Generierter Knowledge-Graph-Output (graphify)
graphify-out/

# Projektfremder Ordner (liegt nur lokal im Repo-Root)
Existenzgruendung-Jobcenter/

# OpenMontage (AGPLv3, eigenes Upstream-Repo) — wird per
# `npm run video:setup` installiert, nicht in dieses Repo vendored.
# Kanonische Steakakademie-Konfiguration liegt in docs/openmontage/.
tools/openmontage/

# Video-Artefakte: aus script.json + Komposition jederzeit reproduzierbar
# (`npm run video:kerntemperatur`). Fertige Videos gehören nach R2, nicht ins Repo.
video/*/out/
video/*/audio/

# Lose Patch-Dateien im Repo-Root (blockA…blockE): Zwischenstände einer
# Umbau-Session, kein Quellcode. Die Änderungen gehören als Commit ins Repo,
# nicht als .patch daneben.
/*.patch

# Bildstil-Referenz (Moodboard für docs/bildprogramm.md). Lag bis 17.08.2026
# unter public/ und wurde damit öffentlich ausgeliefert — verschoben nach
# docs/bildstil/. Bleibt lokal: Arbeitsmaterial, kein Seiteninhalt.
docs/bildstil/

# Lokaler Starter mit hartcodiertem Pfad C:\Dev\steakakademie-v2 und .cmd-Syntax.
# Arbeitsplatz-Komfort, kein Projektbestandteil — `npm run dev` tut dasselbe.
dev-start.cmd

# Staging fuer den Rezeptbild-Austausch: Quellfotos, Zwischenergebnisse und
# Kontaktbogen. Bleibt lokal — ins Repo geht nur das abgenommene Endbild unter
# public/images/rezepte/.
bild-austausch/

# Rechtschreib-Report (Arbeitsdatei, wird je Lauf neu erzeugt)
data/spell-check-report.json

# Git-Lock-Muell. Eine Linux-Session ueber die Ordner-Bruecke kann .git/index.lock
# nicht loeschen (EPERM); die Datei wird stattdessen hierher verschoben, damit die
# naechste Git-Operation nicht blockiert (CLAUDE.md, Abschnitt A). Rein lokal.
_to_delete/

# Lokale Claude-Einstellungen dieser Arbeitskopie, kein Projektbestandteil.
.claude/settings.local.json

# Symlinks, die "npx skills add" von .claude/skills/ nach .agents/skills/ legt.
# Maschinenlokal und auf einem anderen Rechner wertlos; der Inhalt selbst ist
# unter .agents/skills/ versioniert und "npx skills add" erzeugt die Links neu.
.claude/skills/

# 17 MB Affinity-Arbeitsdateien und Zwischenstaende des Cut-Generators. Lagen bis
# 30.08.2026 unter public/images/Cut Generator Bulle/ und waeren von dort oeffentlich
# ausgeliefert worden; verschoben nach docs/cut-atlas/werkstatt/ — gleicher Weg wie
# docs/bildstil/ weiter oben. Bleibt lokal: Arbeitsmaterial, kein Seiteninhalt, und
# 17 MB Binaerdateien gehoeren nicht in die Git-History.
docs/cut-atlas/werkstatt/

# Aeltere, unreferenzierte Fassung des Cut-Posters. Live eingebunden ist
# public/images/cut-atlas-poster.svg; diese Datei ist eine Dublette von
# docs/cut-atlas/cut-diagramm.svg und hat unter public/ nichts verloren.
public/images/cut-diagramm.svg
